{
  "name": "comment-summary-export",
  "version": "1.0.0",
  "description": "This plugin implements a OAuth flow for Figma then gets and summarises comments via the REST api using an express.js server",
  "license": "ISC",
  "scripts": {
    "build": "npm run build:prod",
    "build:dev": "node scripts/build-manifest.js dev && webpack --mode=production",
    "build:prod": "node scripts/build-manifest.js prod && webpack --mode=production",
    "build:watch": "node scripts/build-manifest.js dev && webpack --mode=production --watch",
    "prettier:format": "prettier --write '**/*.{js,jsx,ts,tsx,css,json}' ",
    "start:server": "tsx --esm api/server.ts",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "node dist/server.js",
    "dev:server": "ts-node api/server.ts",
    "postinstall": "npm run build:dev"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.13",
    "@types/cookie-parser": "^1.4.8",
    "axios": "^1.6.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "motion": "^12.19.1",
    "openai": "^4.103.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.50.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.54",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "react-dev-utils": "^12.0.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^4.7.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,css,json}": [
      "prettier --write",
      "git add"
    ]
  }
}
